# ============================================
# Node.js 기반 프로젝트 .gitignore
# (human-bug-tier: frontend static + backend Express)
# ============================================

# ============================================
# Node.js / npm / yarn / pnpm
# ============================================
node_modules/

# 로그 및 디버그
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 런타임 데이터
pids
*.pid
*.seed
*.pid.lock

# ============================================
# 환경 변수 (절대 커밋 금지!)
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# .env.example 은 반드시 커밋하세요 (예시용)

# ============================================
# OS 생성 파일
# ============================================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini

# ============================================
# IDE / Editor
# ============================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ============================================
# 테스트 / 커버리지
# ============================================
coverage/
.nyc_output/
*.lcov
lib-cov/

# ============================================
# 빌드 / 출력 디렉토리 (프로젝트에 따라)
# ============================================
dist/
build/
out/
.cache/
# Oracle Cloud 배포 패키지(backend/deploy/oracle/deploy.sh 가 만드는 tar.gz)
.deploy-out/

# ============================================
# 프로젝트 전용 무시 항목
# ============================================
# Grok / MCP 도구 세션 아티팩트
mcps/
terminals/

# GitHub Pages 로컬 임시 배포 폴더 (CI에서는 생성됨)
gh-pages-deploy/

# Cloudflare Pages 로컬 임시 배포 폴더 (CI에서는 생성됨)
cf-pages-deploy/

# Wrangler 로컬 캐시 (배포 상태, 올리지 않음)
.wrangler/

# ============================================
# 기타 Node 관련
# ============================================
.lock-wscript
.npm/
.eslintcache
.node_repl_history
.yarn-integrity

# 서버리스 / 클라우드 관련 (필요시 주석 해제)
# .serverless/
# .fusebox/
# .dynamodb/

# ============================================
# ai-service (FastAPI, Python)
# ============================================
ai-service/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 벡터 DB 파일(ChromaDB)
ai-service/data/

# README 캡처 원본 프레임 (GIF 재생성용 임시 파일)
docs/readme/raw/

# 작업 중 생성되는 외부 보고서 (추적하지 않음)
JULES_REPORT.md

# Oracle Autonomous DB 지갑 (커밋 금지)
wallet/
Wallet_*/
Wallet_*.zip
*.sso
*.p12
*.jks
ewallet.pem
backend/deploy/oracle/ship.local.env
