# 운영 서버(Oracle VM, 메모리 1GB)용 ai-service 설정 템플릿 — 값(키)은 여기 적지 않는다.
# `bash backend/deploy/oracle/deploy.sh ai-env` 가 이 파일로 서버의 /opt/human-bug-tier/shared/ai.env 를 만들고
# AI_SERVICE_KEY 를 만들어 backend 쪽 shared/.env 와 같은 값으로 맞춘다(값은 화면에 출력하지 않는다).

# ---- 답변 생성 -------------------------------------------------------------
# none      : LLM 없이 사이트 지식 문서에서 그대로 가져온 답만(무료, "AI 서버 OFF 상태" 안내가 뜬다)
# anthropic : Claude API (ANTHROPIC_API_KEY 필요, 호출마다 비용)
# ollama    : 다른 PC/GPU 서버의 Ollama 를 부를 때(OLLAMA_BASE_URL 필요) — 이 VM 에서는 못 돌린다
AI_LLM_PROVIDER=none
AI_MAX_TOKENS=700

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OLLAMA_BASE_URL=
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_TIMEOUT=180

# ---- 벡터 검색 ---------------------------------------------------------------
# 이 VM 에는 임베딩(bge-m3)을 돌릴 곳이 없고 chromadb 도 설치하지 않는다 → 끈다(BM25 키워드 검색만 사용)
AI_VECTOR_ENABLED=false
AI_WARMUP=false

# ---- backend 와 공유하는 키 -------------------------------------------------
# ai-env 가 채운다. backend 의 AI_SERVICE_KEY 와 같은 값이어야 /api/ai 가 동작한다.
AI_SERVICE_KEY=

# ---- Oracle DB (Autonomous Database, thin 모드) ---------------------------------
# 값은 서버에서 직접 채운다: ssh ... 'nano /opt/human-bug-tier/shared/ai.env'  (채팅/명령줄에 비밀번호를 남기지 않기 위해)
# 지갑은 `deploy.sh ai-wallet <wallet.zip>` 로 올리면 shared/oracle-wallet 에 풀리고 ORACLE_WALLET_DIR 이 자동으로 채워진다.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# 저장 스위치 — 둘 다 기본 꺼짐(= 대화를 저장하지 않는다). 테이블은 `scripts/init_oracle.py` 로 먼저 만든다.
AI_STORE_STATS=false            # 질문 수·모드·응답 시간 같은 통계만(질문·답변 내용 없음)
AI_STORE_CHAT=false             # 질문·답변 원문 저장 — 켜기 전에 /ai 화면·개인정보 안내 문구를 "저장합니다"로 고칠 것
AI_CHAT_RETENTION_DAYS=30       # 원문 보관 일수(지나면 자동 삭제)
