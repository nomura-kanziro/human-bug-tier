# 운영 서버(Oracle VM, 메모리 1GB)용 ai-service 설정 템플릿 — 값(키)은 여기 적지 않는다.
# `bash backend/deploy/oracle/deploy.sh ai-env` 가 이 파일로 서버의 /opt/human-bug-tier/shared/ai.env 를 만들고
# AI_SERVICE_KEY 를 만들어 backend 쪽 shared/.env 와 같은 값으로 맞춘다(값은 화면에 출력하지 않는다).

# ---- 답변 생성 -------------------------------------------------------------
# none      : LLM 없이 사이트 지식 문서에서 그대로 가져온 답만(무료, "AI 서버 OFF 상태" 안내가 뜬다)
# anthropic : Claude API (ANTHROPIC_API_KEY 필요, 호출마다 비용)
# ollama    : 다른 PC/GPU 서버의 Ollama 를 부를 때(OLLAMA_BASE_URL 필요) — 이 VM 에서는 못 돌린다
AI_LLM_PROVIDER=none
AI_MAX_TOKENS=700

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OLLAMA_BASE_URL=
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_TIMEOUT=180

# ---- 벡터 검색 ---------------------------------------------------------------
# 이 VM 에는 임베딩(bge-m3)을 돌릴 곳이 없고 chromadb 도 설치하지 않는다 → 끈다(BM25 키워드 검색만 사용)
AI_VECTOR_ENABLED=false
AI_WARMUP=false

# ---- backend 와 공유하는 키 -------------------------------------------------
# ai-env 가 채운다. backend 의 AI_SERVICE_KEY 와 같은 값이어야 /api/ai 가 동작한다.
AI_SERVICE_KEY=
