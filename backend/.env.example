# ============================================
# human-bug-tier — backend 환경변수 예시
# 복사: copy .env.example .env   (Windows, backend 폴더에서)
#       cp .env.example .env
#
# 실행: cd backend && npm start
# dotenv 로드 순서 (server.js):
#   1) 프로젝트 루트 ../.env
#   2) backend/.env  (override: true — 같은 키는 backend 우선)
# 주의: 루트 .env 에 MONGO_URI= 처럼 빈 값만 두면, override 없이는
#       backend 의 실제 URI 가 무시되어 DB 연결이 실패합니다.
# ============================================

# ----- 서버 -----
PORT=5000
NODE_ENV=development

# ----- MongoDB (필수) -----
# MongoDB Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/DBNAME
MONGO_URI=

# ----- 관리자 계정 (서버 시작 시 시드, 필수) -----
ADMIN_INPUT_ID=admin
ADMIN_INPUT_PW=your-secure-password
ADMIN_NAME=관리자

# ----- JWT (프로덕션: 강력한 랜덤 문자열 필수) -----
JWT_SECRET=

# ----- 이메일 -----
# 아래 3가지 중 설정된 걸 전부 순서대로 시도합니다(우선순위: Brevo → Resend → Gmail).
# 앞 방식이 실패(예: Brevo 계정 미활성)해도 뒤에 설정된 게 있으면 자동으로 대체 발송됩니다 —
# 그러니 Brevo만 걸어두지 말고 Gmail도 같이 채워두면 Brevo 승인 대기 중에도 메일이 나갑니다.
#
# 1순위: Brevo HTTPS API (최추천 — 발신자 이메일 1개만 클릭 인증하면 도메인 없이도 임의 수신자에게 발송 가능)
# https://brevo.com 가입 → Senders 탭에서 발신 이메일 인증(메일 수신 후 링크 클릭) → SMTP & API 탭에서 API 키 발급
# 주의: 신규 계정은 API 키가 있어도 Brevo 쪽에서 "트랜잭션(SMTP) 발송"을 수동 승인해야 실제 발송이 됨.
#       403 permission_denied + "not yet activated" 에러면 코드 문제가 아니라 Brevo 고객지원에
#       활성화를 요청해야 함(contact@brevo.com 또는 대시보드 고객지원) — 승인까지 시간이 걸릴 수 있음.
BREVO_API_KEY=
BREVO_FROM=

# 2순위: Resend HTTPS API (도메인 미인증 시 계정 소유자 본인에게만 발송 가능 — 실운영에는 도메인 인증 필요)
# https://resend.com 가입 후 API 키 발급.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# 3순위: Gmail SMTP (로컬처럼 SMTP 포트가 열린 환경용. Render는 막혀 있을 수 있음)
# 설정 시: 가입 인증 + 아이디 찾기 + 비밀번호 재설정 메일
# 미설정 시: 가입 즉시 isVerified=true / 찾기 API는 503(EMAIL_NOT_CONFIGURED)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ----- 이메일/리다이렉트 절대 URL -----
# 로컬: http://localhost:5000
# Render: https://your-app.onrender.com  (끝 슬래시 없이)
APP_URL=http://localhost:5000

# ----- 유튜브 커뮤니티 → 새 소식 자동 연동 (선택) -----
# 기본값: 휴먼버그대학교 채널 게시판을 10분마다 확인해서 새 글을 news 로 등록
# YOUTUBE_POSTS_SYNC_ENABLED=false  로 끄기
YOUTUBE_POSTS_URL=https://www.youtube.com/@humanbug_univ./posts
YOUTUBE_POSTS_POLL_MS=600000
YOUTUBE_POSTS_SYNC_ENABLED=true
# 첫 적재(기존 글 가져오기)는 알림을 보내지 않음. 이후 새 글만 알림.
YOUTUBE_POSTS_SYNC_NOTIFY=true
# 일본어 커뮤니티 글을 한국어로 번역해서 새 소식에 저장 (기본 켜짐)
YOUTUBE_POSTS_TRANSLATE=true
